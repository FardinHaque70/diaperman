rules_version = '2';

// DiaperMan leaderboard rules.
// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // One document per player. The document id is the player's (anonymous) user id.
    match /scores/{uid} {

      function validScore() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'best', 'updatedAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 16
          && d.best is int && d.best >= 0 && d.best <= 1000000
          && d.updatedAt == request.time;
      }

      // Anyone can see the leaderboard
      allow read: if true;

      // Players can only write their own row, and their best can never go down
      allow create: if request.auth != null && request.auth.uid == uid && validScore();
      allow update: if request.auth != null && request.auth.uid == uid && validScore()
        && request.resource.data.best >= resource.data.best;
      allow delete: if false;
    }
  }
}
